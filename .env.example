# Local preview only. Generate a long random admin token before editing API routes.
LIFE_DATA_DIR=runtime
LIFE_ADMIN_TOKEN=
LIFE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LIFE_COOKIE_SECURE=false
# Explicit local owner bootstrap; registration always creates a normal member.
# Set privately in the launching process. Do not commit values.
LIFE_OWNER_EMAIL=
LIFE_OWNER_PASSWORD=
# Values stay in this environment; routing config stores variable names only.
TEXT_PROVIDER_API_KEY=
